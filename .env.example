# =============================================================================
#  PUT YOUR VALUES HERE
# =============================================================================
#  This file is gitignored. After editing, verify with:
#
#      python -m rag check
#
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REQUIRED — your Gemini API key
# -----------------------------------------------------------------------------
# Get one free at: https://aistudio.google.com/apikey
# Sign in with a Google account, click "Create API key", copy it below.
# It looks like: AIzaSy........................................
#
# Paste it after the = with no quotes and no spaces.

GEMINI_API_KEY=your-key-here


# -----------------------------------------------------------------------------
# 2. Which backends to use  (already set for Gemini — no change needed)
# -----------------------------------------------------------------------------
# gemini | groq | ollama | stub
#
# Generator writes the answer; judge verifies citations and grades evals.
# They are separate settings so the grader can differ from the writer.

RAG_LLM_BACKEND=gemini
RAG_JUDGE_BACKEND=gemini


# -----------------------------------------------------------------------------
# 3. OPTIONAL — model choice
# -----------------------------------------------------------------------------
# Leave commented to use the default (gemini-2.5-flash).
#
# Gemini's lineup changes often and free-tier availability is account-specific,
# so if `python -m rag check` says the default is not reachable, it will print
# the models your key CAN use. Uncomment and paste one here.

# RAG_GEMINI_MODEL=gemini-2.5-flash

# Judge model. Blank = same as RAG_GEMINI_MODEL. A cheaper/faster model here
# is reasonable: grading is a simpler task than writing.

# RAG_JUDGE_MODEL=


# -----------------------------------------------------------------------------
# 4. OPTIONAL — a second free tier as backup
# -----------------------------------------------------------------------------
# Groq is fast and free at https://console.groq.com/keys
# Useful if Gemini's daily quota runs out mid-evaluation. To switch, set
# RAG_JUDGE_BACKEND=groq above.

# GROQ_API_KEY=


# -----------------------------------------------------------------------------
# 5. OPTIONAL — tuning (defaults are fine to start)
# -----------------------------------------------------------------------------
# Retrieval fusion weights: dense finds meaning, sparse finds exact terms.
# RAG_DENSE_WEIGHT=0.7
# RAG_SPARSE_WEIGHT=0.3

# How many chunks reach the model.
# RAG_RERANK_TOP_N=5

# Below this confidence the system declines instead of guessing (0.0-1.0).
# RAG_MIN_ANSWER_CONFIDENCE=0.35

# Seconds before an API call is abandoned.
# RAG_LLM_TIMEOUT_SECONDS=120
